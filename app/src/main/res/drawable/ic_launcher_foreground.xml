<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the Gaza Store mark scaled into the 108dp canvas
  safe zone (0.15x of the 500-unit logo space, centred).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.15"
        android:scaleY="0.15"
        android:translateX="16.5"
        android:translateY="16.5">

        <!-- Outer copper disc -->
        <path android:pathData="M35,250 A215,215 0 1 1 465,250 A215,215 0 1 1 35,250 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="35"
                    android:startY="35"
                    android:endX="465"
                    android:endY="465"
                    android:startColor="#FFC28459"
                    android:centerColor="#FFB07146"
                    android:endColor="#FF9C5E35" />
            </aapt:attr>
        </path>

        <!-- Cream rounded square -->
        <path android:pathData="M199,135 L301,135 A64,64 0 0 1 365,199 L365,301 A64,64 0 0 1 301,365 L199,365 A64,64 0 0 1 135,301 L135,199 A64,64 0 0 1 199,135 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="135"
                    android:startY="135"
                    android:endX="365"
                    android:endY="365"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFF7F2E8" />
            </aapt:attr>
        </path>

        <!-- Bag handle -->
        <path
            android:fillColor="#FFB07146"
            android:pathData="M223,244 C223,214 277,214 277,244 C277,250 273,254 267,254 C261,254 259,250 259,244 C259,228 241,228 241,244 C241,250 239,254 233,254 C227,254 223,250 223,244 Z" />

        <!-- Bag body -->
        <path android:pathData="M206,244 L294,244 C297,244 299,247 298,250 L293,298 C292,306 285,312 277,312 L223,312 C215,312 208,306 207,298 L202,250 C201,247 203,244 206,244 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="202"
                    android:startY="244"
                    android:endX="299"
                    android:endY="312"
                    android:startColor="#FFC28459"
                    android:centerColor="#FFB07146"
                    android:endColor="#FF9C5E35" />
            </aapt:attr>
        </path>

        <!-- Handle eyelets -->
        <path
            android:fillColor="#FFF7F2E8"
            android:pathData="M224,259 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
        <path
            android:fillColor="#FFF7F2E8"
            android:pathData="M266,259 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    </group>
</vector>
